# Copy this file to "server/.env" and fill in your own values. ".env" is ignored by Git.
# These are SERVER-ONLY secrets. Never put them in the main .env, never prefix them with VITE_.

# From the CometChat dashboard: your app -> Credentials
COMETCHAT_APP_ID=your-app-id
COMETCHAT_REGION=us
# The REST API Key (fullAccess scope), NOT the Auth Key.
COMETCHAT_REST_API_KEY=your-rest-api-key

# A long random text only the server knows (at least 32 characters). Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later signs every device out (they must create a new account).
OGS_SESSION_SECRET=replace-with-a-long-random-secret

# Which web addresses may call this server (comma separated). Use your real site address when you deploy.
OGS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8787

# Shared CometChat test users (cometchat-uid-1..5). Development only. Keep false on a public server.
ALLOW_DEMO_ACCOUNTS=false
# Set to true only when this server runs behind ONE trusted proxy/host that sets X-Forwarded-For.
TRUST_PROXY=false
