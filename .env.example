# Copy this file to ".env" and fill in your own values.
# ".env" is ignored by Git. Everything here ends up inside the web page, so it must NOT contain secrets.
# Find both in the CometChat dashboard: your app -> Credentials.

VITE_COMETCHAT_APP_ID=your-app-id
VITE_COMETCHAT_REGION=us

# Optional. Leave empty in development. Set it only when the sign-in server lives on another address,
# e.g. https://auth.example.com (also add your site's address to OGS_ALLOWED_ORIGINS in server/.env).
VITE_AUTH_API_URL=

# The private keys (REST API key, session secret) go in server/.env, see server/.env.example.
